<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/owe_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg_light">
    <TextView android:id="@+id/owe_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Do oddania Tobie" android:textColor="#3E4350" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
        <TextView android:id="@+id/owe_who" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#1B1F2A" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="2" />
        <TextView android:id="@+id/owe_amount" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#1F45C8" android:textSize="26sp" android:fontFamily="sans-serif-black" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/owe_extra" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#5F6470" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
