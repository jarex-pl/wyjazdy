<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/wbg_dark">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/trip_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Wyjazdy" android:textColor="#E6EEFF" android:textSize="14sp" android:fontFamily="sans-serif-medium"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/balance_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Twój bilans" android:textColor="#D2DDF7" android:textSize="13sp" />
            <TextView android:id="@+id/balance_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0,00 zł" android:textColor="#FFFFFF" android:textSize="31sp" android:fontFamily="sans-serif" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/balance_hint" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#D2DDF7" android:textSize="13sp" android:maxLines="2" />
        </LinearLayout>
        <LinearLayout android:id="@+id/buttons" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/btn_foreign" android:layout_width="90dp" android:layout_height="54dp" android:gravity="center"
                android:text="+ €" android:textSize="23sp" android:fontFamily="sans-serif-black" android:textColor="#FFFFFF"
                android:background="@drawable/wbtn_accent" />
            <TextView android:id="@+id/btn_pln" android:layout_width="90dp" android:layout_height="54dp" android:layout_marginTop="8dp"
                android:gravity="center" android:text="+ zł" android:textSize="23sp" android:fontFamily="sans-serif-black"
                android:textColor="#FFFFFF" android:background="@drawable/wbtn_gray_d" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
        <TextView android:id="@+id/row1_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/row1_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="#FFFFFF" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:id="@+id/row2_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/row2_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="#FFFFFF" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:id="@+id/row3_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/row3_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="#FFFFFF" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:id="@+id/row4_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/row4_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="#FFFFFF" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:id="@+id/row5_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/row5_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="#FFFFFF" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
