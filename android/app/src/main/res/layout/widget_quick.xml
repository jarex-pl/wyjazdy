<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="@drawable/wbg_navy">

    <TextView android:id="@+id/quick_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Wyjazdy" android:textColor="#FFFFFF" android:textSize="13sp" android:fontFamily="sans-serif-medium"
        android:maxLines="1" android:ellipsize="end" android:paddingStart="2dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:id="@+id/quick_foreign" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="+ €" android:textSize="20sp"
            android:fontFamily="sans-serif-black" android:textColor="#FFFFFF" android:background="@drawable/wbtn_blue_g" />
        <TextView android:id="@+id/quick_pln" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center" android:text="+ zł"
            android:textSize="20sp" android:fontFamily="sans-serif-black" android:textColor="#FFFFFF"
            android:background="@drawable/wbtn_navy2" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:id="@+id/quick_cat1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:textColor="#FFFFFF" android:textSize="11.5sp" android:fontFamily="sans-serif-medium"
            android:maxLines="1" android:ellipsize="end" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="@drawable/wbtn_navy2" android:text="Jedzenie" />
        <TextView android:id="@+id/quick_cat2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="6dp" android:gravity="center" android:textColor="#FFFFFF" android:textSize="11.5sp" android:fontFamily="sans-serif-medium"
            android:maxLines="1" android:ellipsize="end" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="@drawable/wbtn_navy2" android:text="Kawa" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:id="@+id/quick_cat3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:textColor="#FFFFFF" android:textSize="11.5sp" android:fontFamily="sans-serif-medium"
            android:maxLines="1" android:ellipsize="end" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="@drawable/wbtn_navy2" android:text="Paliwo" />
        <TextView android:id="@+id/quick_cat4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="6dp" android:gravity="center" android:textColor="#FFFFFF" android:textSize="11.5sp" android:fontFamily="sans-serif-medium"
            android:maxLines="1" android:ellipsize="end" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="@drawable/wbtn_navy2" android:text="Zakupy" />
    </LinearLayout>
</LinearLayout>
